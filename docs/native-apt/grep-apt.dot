digraph packages {
concentrate=true;
size="30,40";
"grep" -> "libc6"[color=blue];
"grep" -> "libpcre2-8-0"[color=blue];
"grep" -> "rgrep"[color=springgreen];
"libpcre2-8-0" -> "libc6";
"libc6" -> "libgcc-s1";
"libc6" -> "chrony"[color=springgreen];
"libc6" -> "cyrus-imapd"[color=springgreen];
"libc6" -> "fakechroot"[color=springgreen];
"libc6" -> "firefox"[color=springgreen];
"libc6" -> "firefox-esr"[color=springgreen];
"libc6" -> "gnumach-image-1.8-486"[color=springgreen];
"libc6" -> "gnumach-image-1.8-486-dbg"[color=springgreen];
"libc6" -> "gnumach-image-1.8-xen-486"[color=springgreen];
"libc6" -> "gnumach-image-1.8-xen-486-dbg"[color=springgreen];
"libc6" -> "hurd"[color=springgreen];
"libc6" -> "locales"[color=springgreen];
"libc6" -> "locales-all"[color=springgreen];
"libc6" -> "nscd"[color=springgreen];
"libc6" -> "python3-iptables"[color=springgreen];
"libc6" -> "scipy"[color=springgreen];
"libc6" -> "tinydns"[color=springgreen];
"libc6" -> "valgrind"[color=springgreen];
"libgcc-s1" -> "gcc-14-base";
"libgcc-s1" -> "libc6";
